#!/usr/bin/env bash

set -e

### ----------------- Defaults -----------------
MODE="cover"
GIF_PATH=""
THEME_NAME=""
TMPDIR=""

THEMES_DIR="/usr/share/plymouth/themes"

### ----------------- ImageMagick detection -----------------
detect_imagemagick() {
    if command -v magick >/dev/null 2>&1; then
        IM_CMD="magick"
    elif command -v convert >/dev/null 2>&1; then
        IM_CMD="convert"
    else
        echo "Error: ImageMagick no está instalado."
        exit 1
    fi
}

### ----------------- Argument parsing -----------------
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -m|--mode)
            MODE="$2"
            shift 2
            ;;
        *)
            GIF_PATH="$1"
            shift
            ;;
    esac
done

### ----------------- Validations -----------------
if [[ -z "$GIF_PATH" ]]; then
    echo "Uso: $0 [-m cover|centre] archivo.gif"
    exit 1
fi

if [[ ! -f "$GIF_PATH" ]]; then
    echo "Error: El archivo '$GIF_PATH' no existe."
    exit 1
fi

case "$MODE" in
    cover|centre) ;;
    *)
        echo "Modo inválido. Usar: cover o centre"
        exit 1
        ;;
esac

### ----------------- Setup -----------------
THEME_NAME="$(basename "$GIF_PATH" .gif)"
TMPDIR="/tmp/plymouth-build-$THEME_NAME"
FINAL_DIR="$THEMES_DIR/$THEME_NAME"

rm -rf "$TMPDIR"
mkdir -p "$TMPDIR"

detect_imagemagick

echo "Convirtiendo GIF..."
$IM_CMD "$GIF_PATH" -coalesce "$TMPDIR/frame-%d.png"

FRAME_COUNT=$(find "$TMPDIR" -maxdepth 1 -name "frame-*.png" | wc -l)

if [[ "$FRAME_COUNT" -eq 0 ]]; then
    echo "Error: No se generaron frames."
    exit 1
fi

### ----------------- Scale logic -----------------
if [[ "$MODE" == "cover" ]]; then
    SCALE_BLOCK='
    scale_x = screen_w / img_w;
    scale_y = screen_h / img_h;
    scale = Math.Max(scale_x, scale_y);
    '
else
    SCALE_BLOCK='
    scale_x = screen_w / img_w;
    scale_y = screen_h / img_h;
    scale = Math.Min(scale_x, scale_y);
    if (scale > 1)
        scale = 1;
    '
fi

### ----------------- Generate .script -----------------
cat > "$TMPDIR/$THEME_NAME.script" <<EOF
for (i = 0; i < $FRAME_COUNT; i++)
    frames[i] = Image("frame-" + i + ".png");

sprite = Sprite();
progress = 0;

fun refresh_callback () {

    current = Math.Int(progress) % $FRAME_COUNT;

    screen_w = Window.GetWidth(0);
    screen_h = Window.GetHeight(0);

    img_w = frames[current].GetWidth();
    img_h = frames[current].GetHeight();

    $SCALE_BLOCK

    sprite.SetImage(frames[current]);
    sprite.SetScale(scale, scale);

    sprite.SetX((screen_w - img_w * scale) / 2);
    sprite.SetY((screen_h - img_h * scale) / 2);

    progress++;
}

Plymouth.SetRefreshFunction(refresh_callback);
EOF

### ----------------- Generate .plymouth -----------------
cat > "$TMPDIR/$THEME_NAME.plymouth" <<EOF
[Plymouth Theme]
Name=$THEME_NAME
Description=Tema generado automáticamente (modo $MODE)
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/$THEME_NAME
ScriptFile=/usr/share/plymouth/themes/$THEME_NAME/$THEME_NAME.script
EOF

### -------- Handle existing theme --------

if [[ -d "$FINAL_DIR" ]]; then
    echo
    echo "El tema '$THEME_NAME' ya existe."
    echo "¿Qué querés hacer?"
    echo "1) Sobrescribir"
    echo "2) Instalar con nombre nuevo"
    echo "3) Cancelar"
    echo
    read -rp "Elegí una opción [1-3]: " OPTION

    case "$OPTION" in
        1)
            echo "Sobrescribiendo..."
            ;;
        2)
            COUNTER=1
            while [[ -d "$THEMES_DIR/${THEME_NAME}-${COUNTER}" ]]; do
                ((COUNTER++))
            done
            THEME_NAME="${THEME_NAME}-${COUNTER}"
            FINAL_DIR="$THEMES_DIR/$THEME_NAME"

            sed -i "s|Name=.*|Name=$THEME_NAME|" "$TMPDIR/"*.plymouth
            sed -i "s|ImageDir=.*|ImageDir=/usr/share/plymouth/themes/$THEME_NAME|" "$TMPDIR/"*.plymouth

            echo "Nuevo nombre: $THEME_NAME"
            ;;
        *)
            echo "Cancelado."
            rm -rf "$TMPDIR"
            exit 0
            ;;
    esac
fi

### ----------------- Install -----------------
echo
echo "Instalando en $FINAL_DIR ..."

sudo rm -rf "$FINAL_DIR"
sudo mkdir -p "$FINAL_DIR"
sudo cp -r "$TMPDIR/"* "$FINAL_DIR/"

rm -rf "$TMPDIR"

echo
echo "Theme '$THEME_NAME' installed."
echo "Mode: $MODE"
echo "Frames: $FRAME_COUNT"
echo
echo "Install it with:"
echo "sudo plymouth-set-default-theme -R $THEME_NAME"
echo
