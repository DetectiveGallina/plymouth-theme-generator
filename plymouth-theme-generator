#!/usr/bin/env bash

set -e

### ----------------- Defaults -----------------
MODE="cover"
GIF_PATH=""
THEME_NAME=""
TMPDIR=""

THEMES_DIR="/usr/share/plymouth/themes"

### ----------------- Auto resolution detection -----------------

detect_monitor_resolution() {

    local selected_mode=""
    local best_pixels=0
    local best_mode=""

    for status_file in /sys/class/drm/card*-*/status; do

        connector_dir=$(dirname "$status_file")
        connector_name=$(basename "$connector_dir")

        if ! grep -q "^connected" "$status_file"; then
            continue
        fi

        modes_file="$connector_dir/modes"

        [[ -f "$modes_file" ]] || continue

        mode=$(head -n1 "$modes_file")

        width=${mode%x*}
        height=${mode#*x}

        pixels=$((width * height))

        # Prefer internal displays
        if [[ "$connector_name" == *eDP* || "$connector_name" == *LVDS* || "$connector_name" == *DSI* ]]; then
            TARGET_W=$width
            TARGET_H=$height
            return
        fi

        if (( pixels > best_pixels )); then
            best_pixels=$pixels
            best_mode="$mode"
        fi

    done

    if [[ -n "$best_mode" ]]; then
        TARGET_W=${best_mode%x*}
        TARGET_H=${best_mode#*x}
    else
        TARGET_W=1920
        TARGET_H=1080
    fi
}

### ----------------- ImageMagick detection -----------------
detect_imagemagick() {
    if command -v magick >/dev/null 2>&1; then
        IM_CMD="magick"
    elif command -v convert >/dev/null 2>&1; then
        IM_CMD="convert"
    else
        echo "Error: ImageMagick is not installed."
        exit 1
    fi
}

### ----------------- Argument parsing -----------------
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -m|--mode)
            MODE="$2"
            shift 2
            ;;
        *)
            GIF_PATH="$1"
            shift
            ;;
    esac
done

### ----------------- Validations -----------------
if [[ -z "$GIF_PATH" ]]; then
    echo "Usage: $0 [-m cover|centre] file.gif"
    exit 1
fi

if [[ ! -f "$GIF_PATH" ]]; then
    echo "Error: File '$GIF_PATH' does not exist."
    exit 1
fi

case "$MODE" in
    cover|centre) ;;
    *)
        echo "Invalid mode. Use: cover or centre"
        exit 1
        ;;
esac

### ----------------- Setup -----------------
THEME_NAME="$(basename "$GIF_PATH" .gif)"
TMPDIR="/tmp/plymouth-build-$THEME_NAME"
FINAL_DIR="$THEMES_DIR/$THEME_NAME"

rm -rf "$TMPDIR"
mkdir -p "$TMPDIR"

detect_imagemagick

### -------- Handle existing theme --------

if [[ -d "$FINAL_DIR" ]]; then
    echo
    echo "Theme '$THEME_NAME' already exists."
    echo "What do you want to do?"
    echo "1) Overwrite"
    echo "2) Install with new name"
    echo "3) Cancel"
    echo
    read -rp "Choose an option [1-3]: " OPTION

    case "$OPTION" in
        1)
            echo "Overwriting..."
            ;;
        2)
            COUNTER=1
            while [[ -d "$THEMES_DIR/${THEME_NAME}-${COUNTER}" ]]; do
                ((COUNTER++))
            done

            THEME_NAME="${THEME_NAME}-${COUNTER}"
            FINAL_DIR="$THEMES_DIR/$THEME_NAME"

            echo "New name: $THEME_NAME"
            ;;
        *)
            echo "Cancelled."
            rm -rf "$TMPDIR"
            exit 0
            ;;
    esac
fi

### ----------------- GIF conversion -----------------
echo "Processing GIF..."

if [[ "$MODE" == "cover" ]]; then


    detect_monitor_resolution

    echo "Detected target resolution: ${TARGET_W}x${TARGET_H}"
    echo "Applying cover resize and crop..."

    $IM_CMD "$GIF_PATH" \
        -coalesce \
        -resize ${TARGET_W}x${TARGET_H}^ \
        -gravity center \
        -extent ${TARGET_W}x${TARGET_H} \
        -strip \
        -define png:compression-level=9 \
        "$TMPDIR/frame-%d.png"

else

    echo "Extracting frames without scaling..."

    $IM_CMD "$GIF_PATH" \
        -coalesce \
        -strip \
        -define png:compression-level=9 \
        "$TMPDIR/frame-%d.png"

fi

FRAME_COUNT=$(find "$TMPDIR" -maxdepth 1 -name "frame-*.png" | wc -l)

if [[ "$FRAME_COUNT" -eq 0 ]]; then
    echo "Error: No frames were generated."
    exit 1
fi

### ----------------- Generate .script -----------------
cat > "$TMPDIR/$THEME_NAME.script" <<EOF

for (i = 0; i < $FRAME_COUNT; i++)
    frames[i] = Image("frame-" + i + ".png");

sprite = Sprite();

progress = 0;

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

img_w = frames[0].GetWidth();
img_h = frames[0].GetHeight();

sprite.SetX((screen_w - img_w) / 2);
sprite.SetY((screen_h - img_h) / 2);

fun refresh_callback () {

    frame = Math.Int(progress) % $FRAME_COUNT;

    sprite.SetImage(frames[frame]);

    progress = progress + 0.25;

}

Plymouth.SetRefreshFunction(refresh_callback);

EOF

### ----------------- Generate .plymouth -----------------
cat > "$TMPDIR/$THEME_NAME.plymouth" <<EOF
[Plymouth Theme]
Name=$THEME_NAME
Description=Automatically generated theme (mode $MODE)
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/$THEME_NAME
ScriptFile=/usr/share/plymouth/themes/$THEME_NAME/$THEME_NAME.script
EOF

### ----------------- Install -----------------
echo
echo "Installing theme to $FINAL_DIR ..."

sudo rm -rf "$FINAL_DIR"
sudo mkdir -p "$FINAL_DIR"
sudo cp -r "$TMPDIR/"* "$FINAL_DIR/"

rm -rf "$TMPDIR"

echo
echo "Theme '$THEME_NAME' installed."
echo "Mode: $MODE"
echo "Frames: $FRAME_COUNT"
echo
echo "Activation instructions:"
echo

if command -v plymouth-set-default-theme >/dev/null 2>&1; then

    echo "Run:"
    echo "sudo plymouth-set-default-theme -R $THEME_NAME"

else

    echo "Run:"
    echo "sudo update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/$THEME_NAME/$THEME_NAME.plymouth 100"
    echo "sudo update-alternatives --config default.plymouth"
    echo "sudo update-initramfs -u"

fi

echo
